---
import type { CollectionEntry } from 'astro:content';
import { formatRange } from '../lib/content';

interface Props {
	role: CollectionEntry<'experience'>['data'];
	hasDetails: boolean;
}

const { role, hasDetails } = Astro.props;
const name = `${role.title} at ${role.company}`;
---

<article class="role" data-reveal>
	<div class="side">
		<p><time datetime={role.start}>{formatRange(role.start, role.end)}</time></p>
		<p>{role.location}</p>
		{role.end === undefined && <p class="status">Current</p>}
	</div>
	<div class="main">
		<h2>{role.title} <span class="company">at {role.company}</span></h2>
		<ul class="highlights">
			{role.highlights.map((highlight) => <li>{highlight}</li>)}
		</ul>
		{
			role.tech.length > 0 && (
				<ul class="tech" aria-label="Technology">
					{role.tech.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			)
		}
		{
			hasDetails && (
				<details>
					<summary>Details: {name}</summary>
					<div class="body">
						<slot />
					</div>
				</details>
			)
		}
	</div>
</article>

<style>
	.role {
		padding: 28px 0;
		border-top: 1px solid var(--color-line);
	}

	.role:last-child {
		border-bottom: 1px solid var(--color-line);
	}

	.side {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 12px;
		margin-bottom: 8px;
		color: var(--color-muted);
		font-size: var(--text-small);
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 1000px) {
		.role {
			display: grid;
			grid-template-columns: 180px 1fr;
			gap: 24px;
		}

		.side {
			flex-direction: column;
			align-items: flex-start;
			margin: 0;
			padding-top: 3px;
		}
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 2px 8px;
		border-radius: var(--radius-full);
		background: var(--color-ok-soft);
		color: var(--color-ok);
		font-size: var(--text-small);
		font-weight: 600;
	}

	.status::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
	}

	h2 {
		font-size: 18px;
		line-height: 1.4;
		letter-spacing: -0.015em;
	}

	.company {
		display: block;
		margin-top: 2px;
		color: var(--color-muted);
		font-size: var(--text-ui);
		font-weight: 400;
		letter-spacing: normal;
	}

	.highlights {
		display: grid;
		gap: 6px;
		margin-top: 14px;
		padding-left: 18px;
		color: var(--color-ink-2);
		font-size: var(--text-ui);
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 16px;
		padding: 0;
		list-style: none;
	}

	.tech li {
		padding: 2px 8px;
		border-radius: var(--radius-full);
		background: var(--color-surface);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	details {
		margin-top: 12px;
	}

	summary {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: var(--spacing-tap);
		width: fit-content;
		color: var(--color-ink);
		font-size: var(--text-ui);
		font-weight: 500;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before {
		content: '+' / '';
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border: 1px solid var(--color-line-strong);
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1;
	}

	details[open] > summary::before {
		content: '−' / '';
	}

	.body {
		display: grid;
		gap: 12px;
		margin-top: 4px;
		color: var(--color-ink-2);
		font-size: var(--text-ui);
	}
</style>
