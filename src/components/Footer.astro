---
import { getAbout } from '../lib/collections';

const about = await getAbout();
---

<footer class="site-footer">
	<div class="inner">
		<h2>{about.data.name}</h2>
		<p class="place">Published from {about.data.location}.</p>
		<ul>
			{
				about.data.social.map((link) => (
					<li>
						<a href={link.url}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--spacing-section);
		background: var(--color-fir);
		color: var(--color-paper);
	}

	.inner {
		max-width: var(--container-content);
		margin: 0 auto;
		padding: var(--spacing-inner) var(--spacing-margin);
	}

	.place {
		margin-top: 16px;
		font-size: var(--text-small);
		line-height: var(--leading-small);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 24px;
		margin-top: 24px;
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
	}

	a:focus-visible {
		outline-color: var(--color-paper);
	}
</style>
