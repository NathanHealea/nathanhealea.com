---
import { getAbout } from '../lib/collections';

const about = await getAbout();
---

<footer class="site-footer">
	<div class="inner" data-reveal>
		<div>
			<h2>{about.data.name}</h2>
			<p class="place">Based in {about.data.location}.</p>
		</div>
		<ul>
			{
				about.data.social.map((link) => (
					<li>
						<a href={link.url}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--spacing-section);
		border-top: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: var(--text-small);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 16px 32px;
		max-width: calc(var(--container-content) + 2 * var(--spacing-gutter));
		margin: 0 auto;
		padding: 32px var(--spacing-gutter) 40px;
	}

	h2 {
		color: var(--color-ink);
		font-size: var(--text-ui);
		line-height: var(--leading-body);
		letter-spacing: normal;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 20px;
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
		text-decoration: none;
	}

	a:hover {
		color: var(--color-ink);
	}
</style>
