---
import Nav from './Nav.astro';
---

<header class="site-header">
	<div class="inner">
		<a class="wordmark" href="/"><span class="mark" aria-hidden="true">NH</span>Nathan Healea</a>
		<Nav />
		<button class="theme-toggle" type="button" data-theme-toggle hidden>
			<svg class="moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
				<path
					d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linejoin="round"></path>
			</svg>
			<svg class="sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
				<circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
				<path
					d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"></path>
			</svg>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--color-bg);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}

	.site-header:global(.scrolled) {
		border-bottom-color: var(--color-line);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 16px;
		max-width: calc(var(--container-content) + 2 * var(--spacing-gutter));
		min-height: var(--spacing-header);
		margin: 0 auto;
		padding: 0 var(--spacing-gutter);
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: var(--spacing-tap);
		margin-right: auto;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.mark {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 7px;
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0;
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: var(--spacing-tap);
		height: var(--spacing-tap);
		padding: 0;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-sm);
		background: var(--color-raised);
		color: var(--color-ink-2);
		cursor: pointer;
		transition: border-color 0.15s ease;
	}

	.theme-toggle[hidden] {
		display: none;
	}

	.theme-toggle:hover {
		border-color: var(--color-line-strong);
	}

	.sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .sun {
		display: block;
	}

	:global(:root[data-theme='dark']) .moon {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: block;
		}

		:global(:root:not([data-theme='light'])) .moon {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.inner {
			padding-bottom: 4px;
		}

		.inner > :global(nav) {
			order: 3;
			flex-basis: 100%;
		}
	}
</style>
