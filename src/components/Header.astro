---
import Nav from './Nav.astro';
---

<header class="site-header">
	<a class="wordmark" href="/">Nathan Healea</a>
	<Nav />
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0 24px;
		width: 100%;
		max-width: var(--container-content);
		margin: 0 auto;
		padding: 12px var(--spacing-margin);
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-wordmark);
		text-decoration: none;
	}
</style>
