---
import { currentSection, primaryNav } from '../lib/nav';

const current = currentSection(Astro.url.pathname);
---

<nav aria-label="Primary">
	<ul>
		{
			primaryNav.map((item) => (
				<li>
					<a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 24px;
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-min);
		font-size: var(--size-nav);
		text-decoration: none;
		box-shadow: inset 0 calc(-1 * var(--mark-rest)) 0 var(--fir);
		transition: box-shadow var(--mark-duration) ease-out;
	}

	a:hover,
	a:focus-visible {
		box-shadow: inset 0 calc(-1 * var(--mark-hover)) 0 var(--fir);
	}

	a[aria-current='page'] {
		box-shadow: inset 0 calc(-1 * var(--mark-current)) 0 var(--fir);
	}
</style>
