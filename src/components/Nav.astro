---
import { currentSection, primaryNav } from '../lib/nav';

const current = currentSection(Astro.url.pathname);
---

<nav aria-label="Primary">
	<ul>
		{
			primaryNav.map((item) => (
				<li>
					<a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
		padding: 0 12px;
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		font-size: var(--text-ui);
		text-decoration: none;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	a:hover {
		color: var(--color-ink);
		background: var(--color-surface);
	}

	a[aria-current='page'] {
		color: var(--color-ink);
		box-shadow: inset 0 -2px 0 var(--color-ink);
		border-radius: 0;
	}

	@media (max-width: 560px) {
		ul {
			margin-left: -12px;
		}
	}
</style>
