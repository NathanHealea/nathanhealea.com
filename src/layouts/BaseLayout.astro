---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				const stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
			} catch {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to main content</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script>
			import { initialTheme, nextTheme, themeToggleLabel, type Theme } from '../lib/theme';

			const root = document.documentElement;
			const systemDark = matchMedia('(prefers-color-scheme: dark)');
			const resolved = (): Theme => initialTheme(root.dataset.theme, systemDark.matches);

			const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
			if (toggle) {
				const label = () => toggle.setAttribute('aria-label', themeToggleLabel(resolved()));
				label();
				toggle.hidden = false;
				systemDark.addEventListener('change', label);
				toggle.addEventListener('click', () => {
					const next = nextTheme(resolved());
					root.dataset.theme = next;
					try {
						localStorage.setItem('theme', next);
					} catch {
						// Storage blocked: the choice lasts for this page only.
					}
					label();
				});
			}

			const header = document.querySelector('.site-header');
			const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			const reveals = document.querySelectorAll('[data-reveal]');
			if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
				reveals.forEach((element) => element.classList.add('in'));
			} else {
				const observer = new IntersectionObserver(
					(entries) =>
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('in');
							observer.unobserve(entry.target);
						}),
					{ rootMargin: '0px 0px -8% 0px' },
				);
				reveals.forEach((element) => observer.observe(element));
			}
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: 12px;
		left: var(--spacing-gutter);
		z-index: 50;
		padding: 10px 14px;
		border-radius: var(--radius-sm);
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: var(--text-ui);
		font-weight: 500;
		text-decoration: none;
		transform: translateY(calc(-100% - 24px));
	}

	.skip-link:focus-visible {
		transform: none;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100svh;
	}

	main {
		display: block;
		flex: 1 0 auto;
		width: 100%;
		max-width: calc(var(--container-content) + 2 * var(--spacing-gutter));
		margin: 0 auto;
		padding: 0 var(--spacing-gutter);
	}

	main:focus {
		outline: none;
	}
</style>
