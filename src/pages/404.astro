---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Nathan Healea" description="This page isn't on nathanhealea.com.">
	<div class="not-found">
		<p class="side">Error 404. Page not found.</p>
		<h1>Not in the record.</h1>
		<p>This page isn't here. It may have moved when the site was rebuilt.</p>
		<p><a href="/">Return to the home page</a></p>
	</div>
</BaseLayout>

<style>
	.not-found {
		padding-top: var(--gap-inner);
	}

	.side {
		margin: 0 0 24px;
		font-size: var(--size-small);
		line-height: var(--leading-small);
	}

	@media (min-width: 960px) {
		.not-found {
			display: grid;
			grid-template-columns: var(--axis) 1fr;
			align-items: start;
		}

		.not-found > :not(.side) {
			grid-column: 2;
		}

		.side {
			grid-row: 1;
			margin: 18px 32px 0 0;
		}
	}

	p {
		margin-top: 24px;
		font-size: var(--size-standfirst);
		line-height: var(--leading-standfirst);
	}
</style>
