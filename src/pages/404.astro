---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Nathan Healea" description="This page isn't on nathanhealea.com.">
	<div class="not-found">
		<p class="code">404</p>
		<h1>Nothing here.</h1>
		<p class="lede">This page doesn't exist, or it moved when the site was rebuilt.</p>
		<p class="home"><a href="/">Return to the home page</a></p>
	</div>
</BaseLayout>

<style>
	.not-found {
		padding-top: clamp(64px, 10vw, 128px);
	}

	.code {
		margin-bottom: 20px;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-small);
	}

	.lede {
		margin-top: 20px;
		color: var(--color-muted);
		font-size: var(--text-lede);
	}

	.home {
		margin-top: 32px;
	}

	.home a {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
		padding: 0 16px;
		border-radius: var(--radius-sm);
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: var(--text-ui);
		font-weight: 500;
		text-decoration: none;
	}

	.home a:hover {
		background: var(--color-ink-2);
	}
</style>
