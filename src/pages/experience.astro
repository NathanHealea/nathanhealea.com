---
import { render } from 'astro:content';
import ExperienceItem from '../components/ExperienceItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperience } from '../lib/collections';

const roles = await Promise.all(
	(await getExperience()).map(async (entry) => ({
		entry,
		hasDetails: Boolean(entry.body?.trim()),
		Content: (await render(entry)).Content,
	})),
);
---

<BaseLayout
	title="Experience | Nathan Healea"
	description="Nathan Healea's work history: roles, dates, and the technology used in each."
>
	<div class="experience">
		<header class="page-head">
			<h1>Experience</h1>
			<p class="lede">Where I've worked, what I built there, and the tools I used to build it.</p>
		</header>
		<div class="roles">
			{
				roles.map(({ entry, hasDetails, Content }) => (
					<ExperienceItem role={entry.data} hasDetails={hasDetails}>
						{hasDetails && <Content />}
					</ExperienceItem>
				))
			}
		</div>
	</div>
</BaseLayout>

<style>
	.experience {
		padding-top: clamp(48px, 8vw, 96px);
	}

	h1 {
		font-size: var(--text-section);
		letter-spacing: var(--tracking-section);
	}

	.lede {
		margin-top: 16px;
		color: var(--color-muted);
		font-size: var(--text-lede);
		max-width: 40ch;
	}

	.roles {
		margin-top: 48px;
	}

	@media (min-width: 1000px) {
		.experience {
			display: grid;
			grid-template-columns: 4fr 8fr;
			gap: 64px;
		}

		.page-head {
			position: sticky;
			top: calc(var(--spacing-header) + 40px);
			align-self: start;
		}

		.lede {
			max-width: 32ch;
		}

		.roles {
			margin-top: 0;
			min-width: 0;
		}
	}
</style>
