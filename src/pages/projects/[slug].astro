---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ProjectLinks from '../../components/ProjectLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/collections';
import { headingsForToc } from '../../lib/toc';

export const getStaticPaths = (async () => {
	return (await getProjects()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const project = entry.data;
const hasBody = Boolean(entry.body?.trim());
const { Content, headings } = await render(entry);
const toc = headingsForToc(headings);
---

<BaseLayout title={`${project.title} | Nathan Healea`} description={project.description}>
	<nav class="crumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/projects/">Projects</a></li>
			<li><span aria-current="page">{project.title}</span></li>
		</ol>
	</nav>

	<article class="project-detail">
		<header class="case-hero">
			{
				project.tech.length > 0 && (
					<ul class="tech" aria-label="Technology">
						{project.tech.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)
			}
			<h1>{project.title}</h1>
			<p class="description">{project.description}</p>
			<ProjectLinks title={project.title} github={project.github} live={project.live} />
		</header>

		<div class:list={['case-body', { 'has-toc': toc.length > 0 }]}>
			{
				toc.length > 0 && (
					<nav class="toc" aria-label="On this page">
						<ul>
							{toc.map((heading) => (
								<li>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			<div class="article">
				{
					hasBody && (
						<div class="body">
							<Content />
						</div>
					)
				}
				<p class="back"><a href="/projects/">All projects</a></p>
			</div>
		</div>
	</article>
</BaseLayout>

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	const sections = links
		.map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
		.filter((section): section is { link: HTMLAnchorElement; heading: HTMLElement } => section.heading !== null);

	if (sections.length > 0) {
		let queued = false;
		const mark = () => {
			queued = false;
			const line = innerHeight * 0.35;
			const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
			const current = atEnd
				? sections[sections.length - 1]
				: (sections.findLast(({ heading }) => heading.getBoundingClientRect().top <= line) ?? sections[0]);
			for (const { link } of sections) {
				if (link === current.link) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			}
		};
		addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(mark);
			},
			{ passive: true },
		);
		mark();
	}
</script>

<style>
	.crumbs {
		padding-top: 40px;
		color: var(--color-muted);
		font-size: var(--text-small);
	}

	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		padding: 0;
		list-style: none;
	}

	.crumbs li + li::before {
		content: '/' / '';
		margin-right: 8px;
		color: var(--color-line-strong);
	}

	.crumbs a {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--color-ink);
	}

	.crumbs [aria-current] {
		color: var(--color-ink);
	}

	.case-hero {
		padding-top: 24px;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 20px;
		padding: 0;
		list-style: none;
	}

	.tech li {
		padding: 2px 8px;
		border-radius: var(--radius-full);
		background: var(--color-surface);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	h1 {
		max-width: 18ch;
	}

	.description {
		margin-top: 20px;
		max-width: 60ch;
		color: var(--color-muted);
		font-size: var(--text-lede);
	}

	.description + :global(.links) {
		margin-top: 12px;
	}

	.case-body {
		margin-top: 48px;
		padding-top: 48px;
		border-top: 1px solid var(--color-line);
	}

	.toc {
		display: none;
	}

	.toc ul {
		display: grid;
		gap: 2px;
		padding: 0;
		list-style: none;
	}

	.toc a {
		display: block;
		padding: 6px 12px;
		border-left: 2px solid var(--color-line);
		color: var(--color-muted);
		font-size: var(--text-small);
		text-decoration: none;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.toc a:hover {
		color: var(--color-ink);
	}

	.toc a[aria-current] {
		color: var(--color-ink);
		border-left-color: var(--color-accent);
	}

	@media (min-width: 1000px) {
		.case-body.has-toc {
			display: grid;
			grid-template-columns: 220px minmax(0, 1fr);
			gap: 64px;
		}

		.toc {
			display: block;
			position: sticky;
			top: calc(var(--spacing-header) + 40px);
			align-self: start;
		}
	}

	.article {
		max-width: 720px;
		min-width: 0;
	}

	.body {
		color: var(--color-ink-2);
		font-size: 17.5px;
		line-height: 1.7;
	}

	.body :global(h2) {
		margin-top: 56px;
		color: var(--color-ink);
		font-size: var(--text-heading);
		letter-spacing: -0.03em;
	}

	.body :global(h2:first-child) {
		margin-top: 0;
	}

	.body :global(h3) {
		margin-top: 32px;
		color: var(--color-ink);
		font-size: 19px;
	}

	.body :global(p),
	.body :global(ul),
	.body :global(ol),
	.body :global(pre) {
		margin-top: 16px;
	}

	.body :global(ul),
	.body :global(ol) {
		display: grid;
		gap: 8px;
		padding-left: 20px;
	}

	.body :global(a) {
		color: var(--color-ink);
		text-decoration-color: var(--color-accent);
		text-underline-offset: 3px;
	}

	.body :global(code) {
		padding: 1px 6px;
		border: 1px solid var(--color-line);
		border-radius: 5px;
		background: var(--color-surface);
		font-size: 0.88em;
	}

	.body :global(pre) {
		overflow-x: auto;
		padding: 14px 16px;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-raised);
		font-size: 13px;
	}

	.body :global(pre code) {
		padding: 0;
		border: 0;
		background: none;
	}

	.back {
		margin-top: 64px;
	}

	.back a {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-tap);
		color: var(--color-ink);
		font-weight: 500;
		text-decoration-color: var(--color-line-strong);
		text-underline-offset: 4px;
	}

	.back a:hover {
		color: var(--color-accent);
	}
</style>
