---
import ProjectItem from '../../components/ProjectItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/collections';

const projects = await getProjects();
---

<BaseLayout
	title="Projects | Nathan Healea"
	description="Projects Nathan Healea has built, with the technology used and links to the source and live sites."
>
	<header class="page-head">
		<h1>Projects</h1>
		<p class="lede">Things I've built, what they're made of, and where to see them.</p>
	</header>
	<div class="projects">
		{projects.map((entry) => <ProjectItem slug={entry.id} project={entry.data} />)}
	</div>
</BaseLayout>

<style>
	.page-head {
		padding-top: clamp(48px, 8vw, 96px);
	}

	h1 {
		font-size: var(--text-section);
		letter-spacing: var(--tracking-section);
	}

	.lede {
		margin-top: 16px;
		color: var(--color-muted);
		font-size: var(--text-lede);
		max-width: 48ch;
	}

	.projects {
		display: grid;
		gap: 24px;
		margin-top: 48px;
	}

	@media (min-width: 1000px) {
		.projects {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
